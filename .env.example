# The suite refuses state-changing tests unless the acknowledgement exactly
# matches the OSCAR host parsed from OSCAR_BASE_URL.
OSCAR_BASE_URL=https://192.0.2.10
OSCAR_USERNAME=admin
OSCAR_PASSWORD=replace-me
OSCAR_TEST_TARGET_ACK=192.0.2.10

RPM_EMULATOR_URL=http://192.0.2.20:8000
# Required for the full profile; must exactly match the emulator URL host.
RPM_EMULATOR_TARGET_ACK=192.0.2.20
TEST_RPM_ID=rpm-50
TEST_LANE_LABEL=Lane50
# Required for the full profile; explicitly confirms the RPM-to-lane mapping.
RPM_LANE_MAPPING_ACK=rpm-50:Lane50
EXPECTED_LANE_COUNT=50
EXPECTED_CAMERA_COUNT=50
# Controls coverage for the optional event-UUID feature. "auto" skips the
# scenario on older Viewer builds, "required" makes absence a release failure,
# and "disabled" always skips it. Use required when validating a build that
# claims the UUID search/direct-link/export capability.
EVENT_UUID_WORKFLOW=auto
# Controls deterministic camera-scan coverage on Alarm Transfer. "auto" skips
# when camera controls are absent on an older Viewer, "required" makes their
# absence a release failure, and "disabled" always skips the workflow. The
# harness supplies a generated 640x480 Chromium media stream; no physical camera
# or native operating-system permission prompt is involved.
ALARM_TRANSFER_CAMERA_WORKFLOW=auto
# "required" validates all seven fixture-defined operational views, their exact
# lane memberships, real Dashboard-to-Health query persistence, and fail-closed
# invalid/unassigned/duplicate inputs. "auto" skips only when the Viewer lacks
# operational-view support; "disabled" always skips the workflow. Future-build
# release gates default to required; select auto only for an explicit legacy run.
OPERATIONAL_VIEW_WORKFLOW=required
# This same tracked 20-column CSV is the test-site provisioning input and the
# regression membership oracle. Resolve relative paths from the suite checkout.
OSCAR_LANE_CONFIG_PATH=fixtures/oscar-50-lane-config.csv

# SSH is used for resource sampling, the host-wide lease held by every mutating
# run, and the guarded OSCAR 3.9.2 storage probe. Strict host-key checking and
# noninteractive authentication are mandatory.
# This helper is Linux Bash/Docker only. Native Windows Docker Desktop and
# PowerShell/oscar.bat acceptance remains a separately recorded deferred gate.
OSCAR_SSH_TARGET=oscar@192.0.2.10
# OSCAR_SSH_IDENTITY_FILE=/home/runner/.ssh/id_ed25519

# OSCAR 3.9.2 durable-storage coverage defaults to a required release gate.
# Explicit "auto" skips only when no storage target is configured; "disabled"
# is for an intentional legacy run. Every storage probe, including smoke, needs
# the exact Viewer-host/SSH-target/remotely-canonical-release ACK below. The full
# lifecycle is test-lab-only and requires a fresh/disposable database.
# A full generated-alarm media gate also requires the test deployment's OSCAR
# videoRetentionConfig to use 0 days, a 1-minute query, 5 frames, quality 85,
# a 24-hour source rollback grace, and metadataReclamationWorkLimit=200;
# see docs/STORAGE_REGRESSION.md. Keep the packaged/production default at 7 days.
STORAGE_WORKFLOW=required
STORAGE_BACKUP_WORKFLOW=auto
# Required only by the strict `3.9.2-release` certification profile. Point to
# the complete PASS result directory from the matching unfiltered restore drill.
# OSCAR_3_9_2_RESTORE_EVIDENCE_DIR=/srv/oscar-regression-results/restore-run-id
# OSCAR_RELEASE_DIR=/opt/oscar-3.9.2-test
# OSCAR_STORAGE_TARGET_ACK=192.0.2.10|oscar@192.0.2.10|/opt/oscar-3.9.2-test|DISPOSABLE-STORAGE
STORAGE_DATABASE_SCOPE=4
STORAGE_HOT_RETENTION_DAYS=30
STORAGE_ARCHIVE_TIMEOUT_MS=300000
STORAGE_PROBE_TIMEOUT_MS=1800000
# Smoke/read-only retained-media API and gallery coverage needs an already
# retained event ID. An unfiltered full run self-seeds this proof from the exact
# UUIDs it generates, so no pre-existing retained ID is required there. A
# lifecycle-only filter is refused unless this ID is configured and passes the
# exact API/JPEG proof before any lifecycle mutation.
# STORAGE_RETAINED_EVENT_ID=
# STORAGE_LEGACY_EVENT_ID=
# STORAGE_EVENT_NODE_ID=

# NEVER set these for smoke/full. They unlock only the separately invoked
# `--profile restore-drill`, which overwrites PostgreSQL, application state,
# archive, WAL, and deployment credentials on an isolated disposable target.
# All restore-specific paths and acknowledgements, plus
# OSCAR_STORAGE_TARGET_ACK above, must match exactly. Review
# docs/STORAGE_REGRESSION.md before setting them.
# OSCAR_RESTORE_TARGET_ACK=192.0.2.10|oscar@192.0.2.10|/opt/oscar-3.9.2-test|ISOLATED-RESTORE
# OSCAR_RESTORE_DISPOSABLE_ACK=192.0.2.10:DISPOSABLE-NO-PRODUCTION-DATA
# OSCAR_RESTORE_DATA_LOSS_ACK=I-ACCEPT-DESTRUCTIVE-RESTORE
# OSCAR_RESTORE_ARCHIVE_DIR=/srv/oscar-restore/archive
# OSCAR_RESTORE_WAL_ARCHIVE_DIR=/srv/oscar-restore/wal-archive
# OSCAR_RESTORE_BACKUP_DIR=/srv/oscar-restore/backups
# OSCAR_RESTORE_PATHS_ACK=/srv/oscar-restore/archive|/srv/oscar-restore/wal-archive|/srv/oscar-restore/backups|DEDICATED-RESTORE-PATHS

# Optional. Use an already-installed Chrome/Chromium binary instead of the
# Playwright-managed browser (useful on a dedicated Linux runner).
# BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome

# Optional traceability labels included in run.json. The 3.9.2 storage probe
# independently gates exact Compose tags, running/local image IDs, available
# repository digests, and application/PostGIS OCI labels.
# OSCAR_BUILD_LABEL=oscar-3.9.2-build-id-and-git-shas
# EMULATOR_BUILD_LABEL=git-sha-or-release

HEADLESS=true
METRICS_INTERVAL_MS=5000
UI_TIMEOUT_MS=30000
EVENT_TIMEOUT_MS=90000
EXTENDED_OCCUPANCY_SECONDS=70
RESULTS_ROOT=results
